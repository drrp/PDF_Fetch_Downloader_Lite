{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run the library app",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "DEV_NO_LOGIN": "true"
      }
    }
  ]
}